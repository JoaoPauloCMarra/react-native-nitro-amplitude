{
  "name": "react-native-nitro-amplitude-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.js",
    "publish-package": "bun scripts/publish.js",
    "publish-package:dry-run": "bun scripts/publish.js --dry-run --skip-checks --yes",
    "dev": "bun run example:start",
    "build": "bun run --cwd packages/react-native-nitro-amplitude build",
    "lint": "bun run --cwd packages/react-native-nitro-amplitude lint",
    "lint:fix": "bun run --cwd packages/react-native-nitro-amplitude lint:fix",
    "lint:check": "bun run --cwd packages/react-native-nitro-amplitude lint:check",
    "format": "bun run --cwd packages/react-native-nitro-amplitude format",
    "format:check": "bun run --cwd packages/react-native-nitro-amplitude format:check",
    "clean": "bun run --cwd packages/react-native-nitro-amplitude clean",
    "codegen": "bun run --cwd packages/react-native-nitro-amplitude codegen",
    "codegen:check": "bun scripts/check-codegen.ts",
    "typecheck": "bun run --cwd packages/react-native-nitro-amplitude typecheck",
    "typecheck:rn087": "bun scripts/verify-rn087-types.ts",
    "test:types": "bun run --cwd packages/react-native-nitro-amplitude test:types",
    "test": "bun run --cwd packages/react-native-nitro-amplitude test",
    "test:lifecycle": "node scripts/package-doc-lifecycle.test.js && bun scripts/assert-publish-workflow.js && bun test ./scripts/assert-publish-workflow.test.js && bun test ./scripts/run-example-smoke.test.js",
    "test:coverage": "bun run --cwd packages/react-native-nitro-amplitude test:coverage",
    "benchmark": "bun run build && bun run --cwd packages/react-native-nitro-amplitude benchmark",
    "test:cpp": "bun run --cwd packages/react-native-nitro-amplitude test:cpp",
    "test:cpp:sanitize": "bun run --cwd packages/react-native-nitro-amplitude test:cpp:sanitize",
    "test:cpp:coverage": "bun run --cwd packages/react-native-nitro-amplitude test:cpp:coverage",
    "check": "bun run lint:check && bun run format:check && bun run typecheck && bun run test:types && bun run test && bun run test:cpp && bun run test:lifecycle",
    "check:ci": "bun run codegen:check && bun run check && bun run benchmark && bun run test:cpp:sanitize && bun run verify:core-versions && bun run typecheck:rn087",
    "audit:package": "bun run --cwd packages/react-native-nitro-amplitude check:pack && bun pm pack --cwd packages/react-native-nitro-amplitude --dry-run",
    "release:preflight": "bun run check:ci && bun run example:check && bun run audit:package && bun run publish-package:dry-run",
    "example:start": "bun run --cwd apps/example start",
    "example:start:fixture": "bun run --cwd apps/example start:fixture",
    "example:ios": "bun run --cwd apps/example ios",
    "example:android": "bun run --cwd apps/example android",
    "example:doctor": "bun run --cwd apps/example doctor",
    "example:lint": "bun run --cwd apps/example lint",
    "example:typecheck": "bun run --cwd apps/example typecheck",
    "example:install-check": "bun run --cwd apps/example install-check",
    "example:config": "bun run --cwd apps/example config:introspect",
    "example:check": "bun run example:doctor && bun run example:install-check && bun run example:config && bun run example:lint && bun run example:typecheck",
    "example:prebuild": "bun run --cwd apps/example prebuild",
    "example:prebuild:clean": "bun run --cwd apps/example prebuild:clean",
    "example:android:assemble": "bun run --cwd apps/example android:assemble",
    "example:ios:build": "bun run --cwd apps/example ios:build",
    "example:smoke": "bun scripts/run-example-smoke.js",
    "example:e2e": "bun scripts/run-example-smoke.js --e2e e2e/qa-full-features.ad --retries 1",
    "example:e2e:android": "bun scripts/run-example-smoke.js --e2e e2e/qa-full-features.ad --device \"RN Expo MidRange\" --retries 1",
    "example:e2e:ios": "bun scripts/run-example-smoke.js --e2e e2e/qa-full-features.ad --device \"iPhone 17 Pro Max (iOS 26.5)\" --retries 1",
    "example:e2e:deeplink": "bun scripts/run-example-smoke.js --e2e e2e/qa-deeplink.ad --retries 1",
    "example:e2e:deeplink:android": "bun scripts/run-example-smoke.js --e2e e2e/qa-deeplink.ad --device \"RN Expo MidRange\" --retries 1",
    "example:e2e:deeplink:ios": "bun scripts/run-example-smoke.js --e2e e2e/qa-deeplink.ad --device \"iPhone 17 Pro Max (iOS 26.5)\" --retries 1",
    "example:smoke:fixture": "EXPO_PUBLIC_AMPLITUDE_DRY_RUN=1 bun scripts/run-example-smoke.js",
    "verify:core-versions": "bun scripts/verify-core-versions.ts",
    "example:smoke:ci": "node scripts/assert-example-smoke.js"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint-config-expo-magic": "^3.0.2",
    "jest": "30.3.0",
    "nitrogen": "0.37.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "0.37.1",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-modules": "0.37.1",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "@types/react": "~19.2.18"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver"
  ]
}
