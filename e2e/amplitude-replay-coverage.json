    {
      "path": "e2e/qa-deeplink.ad",
      "purpose": "App and identity deep-link routes"
    },
    {
      "path": "e2e/qa-network.ad",
      "purpose": "Run-on-load native HTTP errors, nitroTransport delivery, native Experiment fetch, and diagnostics against the local fixture"
