open "nitroamplitude://e2e?fixtureUrl=${FIXTURE_URL}&runId=${RUN_ID}"
scroll top
wait text "dry-run fixture"
open "com.nitroamplitude.example" "nitroamplitude://e2e?fixtureUrl=${FIXTURE_URL}&runId=${RUN_ID}" --relaunch
wait text "dry-run fixture"
wait id="e2e-screen"
wait text "e2e-ready"
scroll bottom
wait id="e2e-lab"
wait id="e2e-results"
wait text "ok:ready"
scroll bottom
press id="e2e-context-run"
wait text "ok:context=device+session"
scroll bottom
press id="e2e-identify-run"
wait text "ok:identity=user=e2e-user:event=recorded"
scroll bottom
press id="e2e-opt-out-run"
wait text "ok:optout=suppressed:reset=restored"
scroll bottom
press id="e2e-revenue-run"
wait text "ok:revenue=sku:e2e-sku:qty=2"
scroll bottom
press id="e2e-group-run"
wait text "ok:group=plan:e2e:event=recorded"
scroll bottom
press id="e2e-native-http-run"
wait text "ok:native-http=echo"
scroll bottom
press id="e2e-native-http-error-run"
wait text "ok:native-http=status=503"
scroll bottom
press id="e2e-network-policy-run"
wait text "ok:network=blocked"
scroll bottom
press id="e2e-screen-run"
wait text "ok:screen=e2e-lab:dedup=1"
scroll bottom
press id="e2e-health-run"
wait text "ok:health=true:safe=true:full=true"
scroll bottom
press id="e2e-records-run"
wait text "ok:events=record-probe"
scroll bottom
press id="e2e-flush-run"
wait text "ok:flush=ok:event=flush-probe:sent="
scroll bottom
press id="e2e-variant-run"
wait text "ok:flag=on"
scroll bottom
press id="e2e-lifecycle-run"
wait text "ok:lifecycle=stale-then-fresh"
scroll bottom
press id="e2e-client-run"
wait text "ok:combined=user+connector+event"
scroll bottom
press id="e2e-run-stress"
wait text "ok:stress=50:delivered=50"
scroll top
wait id="smoke-run-all"
press id="smoke-run-all"
wait text "Complete: PASS"
close
