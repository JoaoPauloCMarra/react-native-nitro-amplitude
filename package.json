{
  "name": "react-native-nitro-amplitude-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.js",
    "publish-package": "bun scripts/publish.js",
    "publish-package:dry-run": "bun scripts/publish.js --dry-run --skip-checks --yes",
    "dev": "bun run example:start",
    "build": "bun run --cwd packages/react-native-nitro-amplitude build",
    "lint": "bun run --cwd packages/react-native-nitro-amplitude lint",
    "lint:fix": "bun run --cwd packages/react-native-nitro-amplitude lint:fix",
    "lint:check": "bun run --cwd packages/react-native-nitro-amplitude lint:check",
    "format": "bun run --cwd packages/react-native-nitro-amplitude format",
    "format:check": "bun run --cwd packages/react-native-nitro-amplitude format:check",
    "clean": "bun run --cwd packages/react-native-nitro-amplitude clean",
    "codegen": "bun run --cwd packages/react-native-nitro-amplitude codegen",
    "codegen:check": "bun scripts/check-codegen.ts",
    "typecheck": "bun run --cwd packages/react-native-nitro-amplitude typecheck",
    "test:types": "bun run --cwd packages/react-native-nitro-amplitude test:types",
    "test": "bun run --cwd packages/react-native-nitro-amplitude test",
    "test:coverage": "bun run --cwd packages/react-native-nitro-amplitude test:coverage",
    "benchmark": "bun run build && bun run --cwd packages/react-native-nitro-amplitude benchmark",
    "test:cpp": "bun run --cwd packages/react-native-nitro-amplitude test:cpp",
    "test:cpp:sanitize": "bun run --cwd packages/react-native-nitro-amplitude test:cpp:sanitize",
    "test:cpp:coverage": "bun run --cwd packages/react-native-nitro-amplitude test:cpp:coverage",
    "check": "bun run lint:check && bun run format:check && bun run typecheck && bun run test:types && bun run test && bun run test:cpp",
    "check:ci": "bun run codegen:check && bun run check && bun run benchmark && bun run test:cpp:sanitize && bun run verify:core-versions",
    "audit:package": "bun run --cwd packages/react-native-nitro-amplitude check:pack && bun pm pack --cwd packages/react-native-nitro-amplitude --dry-run",
    "release:preflight": "bun run check:ci && bun run example:check && bun run audit:package && bun run publish-package:dry-run",
    "example:start": "bun run --cwd apps/example start",
    "example:ios": "bun run --cwd apps/example ios",
    "example:android": "bun run --cwd apps/example android",
    "example:doctor": "bun run --cwd apps/example doctor",
    "example:lint": "bun run --cwd apps/example lint",
    "example:typecheck": "bun run --cwd apps/example typecheck",
    "example:check": "bun run example:doctor && bun run example:lint && bun run example:typecheck",
    "example:prebuild": "bun run --cwd apps/example prebuild",
    "example:prebuild:clean": "bun run --cwd apps/example prebuild:clean",
    "example:android:assemble": "bun run --cwd apps/example android:assemble",
    "example:ios:build": "bun run --cwd apps/example ios:build",
    "example:smoke": "bunx maestro test maestro/smoke-tests.yaml",
    "verify:core-versions": "bun scripts/verify-core-versions.ts"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "eslint-config-expo-magic": "^3.0.0",
    "jest": "30.3.0",
    "nitrogen": "0.36.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "0.36.4",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-nitro-modules": "0.36.4",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-constants": "~57.0.8",
    "@types/react": "~19.2.17"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver"
  ]
}
